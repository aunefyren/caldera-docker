# Normalize all text files to LF in the repository.
# This checkout lives under a Windows path, where editors happily write CRLF;
# without this, every touched file shows up as a whole-file diff.
* text=auto eol=lf

# Files that are executed inside the image must be LF regardless of platform:
# CRLF here produces `\r` in shebangs and ENTRYPOINT commands, which fails at
# runtime with errors that look nothing like a line-ending problem.
*.sh            text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.svg           text eol=lf

# Never touch these.
*.png           binary
*.jpg           binary
*.ico           binary
*.tar.gz        binary
*.tar.bz2       binary
